{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph.v3.json",
  "title": "causal-map graph.json v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "nodes",
    "edges",
    "cors"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "meta": {
      "type": "object",
      "required": [
        "version",
        "generated",
        "nodes",
        "edges",
        "levels"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated": {
          "type": "string"
        },
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "marketRegime": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "code",
            "label",
            "asof"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "asof": {
              "type": "string",
              "minLength": 4,
              "maxLength": 20
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cat": {
            "type": [
              "string",
              "null"
            ],
            "description": "구버전(v1 이하) 호환용. 앱은 읽지 않고 무시한다. 새 데이터는 sector만 쓴다."
          },
          "layer": {
            "type": [
              "integer",
              "null"
            ]
          },
          "series": {
            "type": [
              "string",
              "null"
            ]
          },
          "desc": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 240
          },
          "descSrc": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120
          },
          "aka": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "sector": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "macro",
              "finance",
              "semi",
              "bio",
              "energy",
              "trade",
              "policy",
              "labor",
              "other",
              null
            ],
            "description": "구심점 섹터(11/23). 없으면 other 취급."
          },
          "tier": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "core",
              "bridge",
              "econ",
              null
            ],
            "description": "노드 계층 티어(v3): core=시장 핵심, bridge=핵심 1-hop 연결, econ=이론·배경."
          },
          "state": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "z",
              "chg",
              "win",
              "asof",
              "fresh"
            ],
            "properties": {
              "z": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "chg": {
                "type": "string",
                "maxLength": 32
              },
              "win": {
                "enum": [
                  "21D",
                  "1M",
                  "1Q"
                ]
              },
              "asof": {
                "type": "string",
                "minLength": 4,
                "maxLength": 20
              },
              "fresh": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "src",
          "dst",
          "sign",
          "level",
          "status",
          "note",
          "r",
          "rsrc",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "dst": {
            "type": "string",
            "minLength": 1
          },
          "sign": {
            "enum": [
              "+",
              "-",
              "±"
            ]
          },
          "level": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "cond": {
            "type": [
              "string",
              "null"
            ]
          },
          "lag": {
            "enum": [
              "immediate",
              "short",
              "medium",
              "long",
              null
            ]
          },
          "regime": {
            "type": [
              "string",
              "null"
            ]
          },
          "strength": {
            "type": [
              "string",
              "null"
            ]
          },
          "sub": {
            "enum": [
              "+",
              "-"
            ]
          },
          "flags": {
            "type": [
              "array",
              "null"
            ],
            "uniqueItems": true,
            "items": {
              "enum": [
                "reverse-lead",
                "confounded",
                "regime-flip",
                "sign-mismatch"
              ]
            }
          },
          "stats": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "freq": {
                "enum": [
                  "D",
                  "W",
                  "M",
                  "Q",
                  null
                ]
              },
              "eraAgree": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "r": {
            "type": [
              "number",
              "null"
            ]
          },
          "rsrc": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "stance"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string"
                },
                "stance": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "cors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "src",
          "dst",
          "r"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "dst": {
            "type": "string"
          },
          "r": {
            "type": "number"
          },
          "n": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
